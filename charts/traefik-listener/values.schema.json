{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/Dancing-Yetis/helm-charts",
    "type": "object",
    "required": [
        "service",
        "hostname"
    ],
    "properties": {
        "alt_names": {
            "description": "List of alt names to attach to the certificate",
            "type": [
                "array",
                "null"
            ]
        },
        "entryPoints": {
            "description": "List of entrypoints to create IngressRoutes for. (e.g.: \"web\", \"websecure\")",
            "type": [
                "array",
                "null"
            ],
            "items": {
                "type": "object",
                "properties": {
                    "middlewares": {
                        "description": "List of middlewares to associate with this IngressRoute",
                        "type": [
                            "array",
                            "null"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "services": {
                        "description": "List of Service that should respond to this rule",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "port": {
                                    "description": "ContainerPort to target",
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "tls": {
                        "description": "Enable TLS on this entrypoint",
                        "type": "boolean"
                    }
                }
            }
        },
        "force_compression": {
            "description": "Enable compression on non-web ports",
            "type": "boolean"
        },
        "force_redirect": {
            "description": "Enable redirect middleware on web port",
            "type": "boolean"
        },
        "hostname": {
            "description": "Host to match route requests and generate Certificate for",
            "type": "string"
        },
        "namespace": {
            "description": "Namespace to deploy these resources into",
            "type": [
                "string",
                "null"
            ]
        },
        "service": {
            "description": "Service name to use in any IngressRoute or Certificate resources",
            "type": "string"
        }
    },
    "additionalProperties": false
}
